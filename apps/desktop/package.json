{
  "name": "openclaw-desktop",
  "version": "0.2.4",
  "private": true,
  "description": "OpenClaw CS desktop shell (tray + embedded admin console)",
  "main": "main.js",
  "author": "OpenClaw CS",
  "scripts": {
    "prestart": "node ensure-electron.js",
    "start": "electron .",
    "dev": "electron .",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/Pack-Desktop.ps1",
    "pack:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/Pack-Desktop.ps1 -SkipBuilder"
  },
  "devDependencies": {
    "electron": "^34.5.1",
    "electron-builder": "^25.1.8"
  }
}
