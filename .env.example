# OpenClaw edge env (do not commit)
# Mid-platform secrets -> brain\.env (DATABASE_URL = Supabase, no Docker)

DEPLOY_ROLE=all
OPENCLAW_PORTABLE_ROOT=F:\OpenClaw-USB-Portable
BRAIN_ROOT=F:\openclawProject\brain
ADMIN_PORT=18790
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_CDP_URL=http://127.0.0.1:18800
RAG_BASE_URL=http://127.0.0.1:8787
RAG_API_KEY=local-dev-key

# 企业微信智能机器人（长连接）。启用 platforms.wecom.enabled 后 npm run start:wecom
# WECOM_AIBOT_ID=
# WECOM_AIBOT_SECRET=

# OpenClaw 对话模型（API Key / Base URL / 主模型）请在配置中心「OpenClaw LLM」保存；
# 实际写入便携包 data\.openclaw\.env 与 openclaw.json，不要把密钥提交到 Git。

# Legacy only if brain\rag-service missing:
# SKELETON_ROOT=F:\customer-ai-platform-skeleton\customer-ai-platform-skeleton
