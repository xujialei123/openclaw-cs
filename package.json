{
  "name": "openclaw-cs",
  "private": true,
  "version": "0.2.0",
  "description": "OpenClaw CS monorepo: console + edge-worker + brain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-All.ps1",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-All.ps1",
    "start:mid": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Mid.ps1",
    "stop:mid": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Stop-Mid.ps1",
    "start:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-CsWatch.ps1",
    "start:wecom": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-WecomBridge.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Stop-All.ps1",
    "stop:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Stop-All.ps1",
    "edge": "node apps/edge-worker/cs-watch.js",
    "edge:once": "node apps/edge-worker/cs-watch.js --once",
    "edge:dev": "node --watch --watch-path=apps/edge-worker apps/edge-worker/cs-watch.js",
    "wecom": "node apps/wecom-bridge/index.js",
    "desktop": "npm --prefix apps/desktop start",
    "desktop:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Pack-Desktop.ps1 -Mode both",
    "desktop:dist:edge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Pack-Desktop.ps1 -Mode edge",
    "desktop:dist:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Pack-Desktop.ps1 -Mode fullstack",
    "scenario": "node apps/edge-worker/scenario-runner.js",
    "console": "node scripts/run-next-console.js dev",
    "console:build": "node scripts/run-next-console.js build",
    "console:start": "node scripts/run-next-console.js start",
    "admin:legacy": "node scripts/kb-admin-server.js",
    "db:init": "node scripts/init-remote-db.js",
    "pack:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Pack-LocalDeploy.ps1",
    "pack:openclaw-clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Pack-OpenClaw-Clean.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
