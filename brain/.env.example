# Mid-platform (brain) env — do not commit.
# Used by: rag-service (CUSTOMER_AI_ROOT=brain). Schema: npm run db:init

NODE_ENV=development
RAG_SERVICE_PORT=8787
RAG_API_KEY=local-dev-key

# Supabase Session pooler (port 5432, not 6543). Enable extension `vector`.
# Password `@` must be encoded as %40
DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

VECTOR_STORE=pgvector
VECTOR_DIM=1536

# Qwen / DashScope Embedding
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_dashscope_key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536

# Optional mid-platform LLM helpers (not OpenClaw Gateway; Gateway keys are in portable data\.openclaw\.env via admin 「OpenClaw LLM」)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
