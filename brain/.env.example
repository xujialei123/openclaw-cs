# Mid-platform (brain) env — do not commit.
# Used by: rag-service (CUSTOMER_AI_ROOT=brain), Ensure-Infra DB name.

NODE_ENV=development
RAG_SERVICE_PORT=8787
RAG_API_KEY=local-dev-key

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/customer_ai?schema=public
REDIS_URL=redis://127.0.0.1:6379

VECTOR_STORE=pgvector
VECTOR_DIM=1536

# Qwen / DashScope Embedding
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_dashscope_key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536
